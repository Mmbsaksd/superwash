# ==============================================================================
# SuperWash Express — Production & Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# ------------------------------------------------------------------------------
# Live Authoritative Database & Auth: Connects to your Supabase PostgreSQL project.
# In live mode (VITE_DEMO_MODE=false), all operations are strictly persisted in Supabase.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo & Development Mode Toggle:
# Set to 'true' only for local isolated demo with simulated 1-click Google & Persona logins.
# Set to 'false' for production deployments with real Google OAuth and strict RLS role enforcement.
VITE_DEMO_MODE=false

# Default business branding & contact
VITE_BUSINESS_NAME=SuperWash Express
VITE_BUSINESS_PHONE=+91 98765 43210
VITE_BUSINESS_ADDRESS=Shop #14, Metro Pillar 78, Indiranagar, Bengaluru, Karnataka 560038

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CONFIGURATION (Configured in Supabase Dashboard - NOT in Frontend!)
# ------------------------------------------------------------------------------
# Google OAuth Client ID & Secret must NEVER be prefixed with VITE_ or exposed in client code.
# Configure them directly in:
# Supabase Dashboard -> Authentication -> Providers -> Google
# - Client ID: e.g. 1234567890-abcdefg.apps.googleusercontent.com
# - Client Secret: e.g. GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# - Authorized Redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE & SUPABASE EDGE FUNCTION SECRETS (DO NOT EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# These secrets MUST NOT have the VITE_ prefix. Configure these in your Supabase
# Project Settings -> Secrets / Vault or in your backend server environment.

# Supabase Server-Role Key (For administrative maintenance and trusted migrations only)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Meta WhatsApp Cloud API credentials for server-side dispatch (send-whatsapp Edge Function)
# WHATSAPP_API_TOKEN=your-whatsapp-system-user-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-registered-phone-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# ------------------------------------------------------------------------------
# 4. LEGACY / DEPRECATED FASTAPI BACKEND (OPTIONAL)
# ------------------------------------------------------------------------------
# The primary authoritative data path for SuperWash Express is Supabase PostgreSQL.
# If running the legacy FastAPI microservice in backend/, configure:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/superwash
# SECRET_KEY=generate-a-secure-random-256-bit-key-here
# ENVIRONMENT=production
