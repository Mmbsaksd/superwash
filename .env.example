# ==============================================================================
# SuperWash Express - Mobile-First Laundry Pickup & Delivery App
# Environment Configuration Template
# ==============================================================================

# 1. Supabase PostgreSQL & API Configuration
# Get these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Business Default Pricing & Identity (Can also be edited live in Owner Dashboard)
VITE_BUSINESS_NAME=SuperWash Express
VITE_BUSINESS_PHONE=+91 98765 43210
VITE_BUSINESS_ADDRESS=Shop #14, Metro Pillar 78, Indiranagar, Bengaluru 560038
VITE_PRICE_PER_KG=80
VITE_MIN_WEIGHT_KG=3
VITE_DELIVERY_CHARGE=0
VITE_BUSINESS_UPI_ID=superwash@upi

# 3. Optional WhatsApp Business API Configuration
# Leave blank or false for offline logging. The app operates normally without external credentials.
VITE_WHATSAPP_ENABLED=false
VITE_WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your-phone-number-id/messages
VITE_WHATSAPP_BEARER_TOKEN=your-meta-whatsapp-system-user-token

# 4. Authentication Mode
# In local development without SMS credits, test OTP 123456 is supported out of the box.
VITE_AUTH_TEST_MODE=true
